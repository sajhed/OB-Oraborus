{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OB Oraborus",
  "version": "0.1.0",
  "identifier": "com.oraborus.ob",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OB Oraborus",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://generativelanguage.googleapis.com https://api.github.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 OB Oraborus Contributors",
    "shortDescription": "Local-first AI operating layer for Windows",
    "longDescription": "OB Oraborus coordinates AI models, agents, tools, memory, automation, and verified Windows actions through explicit permissions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../agents", "../tools", "../integrations", "../browser"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "startMenuFolder": "OB Oraborus"
      }
    }
  }
}
